# Copy this file to .env.local and add your Sanity project ID.
# Create a project at https://www.sanity.io/manage if you do not have one yet.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-17

# Public site URL used for sitemap.xml, robots.txt, and canonical/Open Graph links.
# Example: https://computingyard.com
NEXT_PUBLIC_SITE_URL=

# Contact form (Resend). Never prefix RESEND_API_KEY with NEXT_PUBLIC_.
# For testing, Resend allows: Computing Yard <onboarding@resend.dev>
# After domain verification, switch CONTACT_FROM_EMAIL to a computingyard.com sender.
RESEND_API_KEY=
CONTACT_RECEIVER_EMAIL=zainzeeshan412@gmail.com
CONTACT_FROM_EMAIL="Computing Yard <onboarding@resend.dev>"

# Chatbot via OpenRouter (server-side only). Never prefix these with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Legacy aliases still accepted if OPENROUTER_* are unset.
# OPENAI_API_KEY=
# OPENAI_MODEL=

# MongoDB Atlas (server-side only) — Phase 10A chat history persistence.
# Example: mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# Optional database name (default: computing_yard_chat)
# MONGODB_DB=computing_yard_chat

# Embeddings via OpenRouter (server-side only). Uses OPENROUTER_API_KEY by default.
# Model must produce RAG_VECTOR_SIZE dimensions (1536 for text-embedding-3-small).
EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_BATCH_SIZE=32

# Qdrant vector database (server-side only). Used by RAG indexing phases.
# Never prefix these with NEXT_PUBLIC_. Do not expose to the browser.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=computing-yard-rag

# Embedding vector size for collection creation. Must match the embedding model.
# 1536 = openai/text-embedding-3-small via OpenRouter.
RAG_VECTOR_SIZE=1536

# Optional. Cosine (default), Euclid, or Dot.
RAG_DISTANCE=Cosine

# Semantic / hybrid retrieval (Phases 7–9). Server-side only.
# Live chatbot uses hybrid RAG with Sanity keyword fallback on infrastructure failure.
RAG_SEMANTIC_LIMIT=8
# Optional minimum cosine score (0–1). Leave empty until calibrated with eval queries.
RAG_SEMANTIC_SCORE_THRESHOLD=
# Optional max query length in characters (default 1000).
# RAG_SEMANTIC_MAX_QUERY_CHARS=1000

# Hybrid retrieval (Phase 8+). Used by live chatbot via retrieveChatKnowledge().
RAG_LEXICAL_LIMIT=8
RAG_HYBRID_CANDIDATE_LIMIT=12
RAG_CONTEXT_LIMIT=6
RAG_MAX_CHUNKS_PER_DOCUMENT=2
# Reciprocal Rank Fusion constant k (default 60). Not claimed optimal.
RAG_HYBRID_RRF_K=60
# Optional soft floors for dropping weak final context (defaults: rerank 0.05, semantic 0.18).
# RAG_CONTEXT_MIN_RERANK_SCORE=
# RAG_CONTEXT_MIN_SEMANTIC_SCORE=

# Reranker via OpenRouter Cohere (uses OPENROUTER_API_KEY / OPENAI_API_KEY).
# Set RAG_RERANK_ENABLED=false to skip reranking and return hybrid order.
RAG_RERANK_MODEL=cohere/rerank-v3.5
# RAG_RERANK_ENABLED=true
# RAG_RERANK_TOP_N=
